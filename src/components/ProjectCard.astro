---
import type { Project } from '../data/portfolio';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
---
<article class="project-card">
  <div class="project-top"><span class="project-number">0{index + 1}</span><span class="status">{project.status}</span></div>
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  <ul class="tags" aria-label="Technologies and categories">
    {project.tags.map(tag => <li>{tag}</li>)}
  </ul>
  {project.href && <a class="project-link" href={project.href}>Explore {project.title} <span aria-hidden="true">↗</span></a>}
</article>
