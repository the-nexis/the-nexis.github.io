---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { profile } from '../../data/portfolio';
import { getPosts, formatDate } from '../../data/blog';

export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} — ${profile.name}`} description={post.data.description}>
  <div class="site-shell">
    <Header />
    <main id="main" class="post-page">
      <a class="text-link" href="/blog/">← All posts</a>
      <article>
        <header class="post-heading">
          <time class="eyebrow" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <h1>{post.data.title}</h1>
          <p>{post.data.description}</p>
        </header>
        <div class="prose"><Content /></div>
      </article>
    </main>
    <footer><a href="/blog/">← All posts</a><a href="#main">Back to top ↑</a></footer>
  </div>
</Layout>
