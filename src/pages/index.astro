---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects } from '../data/portfolio';
---
<Layout title={`${profile.name} — Projects & experiments`} description={profile.description}>
  <div class="site-shell">
    <header class="site-header">
      <a class="wordmark" href="/" aria-label={`${profile.name} home`}><span class="brand-mark" aria-hidden="true">n.</span>{profile.name}</a>
      <nav aria-label="Main navigation">
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span> A personal corner of the internet</p>
        <h1 id="hero-title">{profile.title}</h1>
        <div class="hero-bottom">
          <p>{profile.description}</p>
          <a class="button" href="#projects">Explore the projects <span aria-hidden="true">↓</span></a>
        </div>
      </section>
      <section id="projects" class="projects-section" aria-labelledby="projects-title">
        <div class="section-heading"><h2 id="projects-title">The project shelf</h2><span class="eyebrow">01 / Work & ideas</span></div>
        <p class="section-intro">A starting point for what comes next. Real projects will live here soon.</p>
        <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
      </section>
      <section id="about" class="about-section" aria-labelledby="about-title">
        <div><p class="eyebrow">02 / Behind the projects</p><h2 id="about-title">Hello, I’m {profile.name}.</h2></div>
        <div><p>{profile.about}</p><a class="text-link" href={profile.github}>Find me on GitHub <span aria-hidden="true">↗</span></a></div>
      </section>
    </main>
    <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>Built with Astro. Made to grow.</span><a href="#main">Back to top ↑</a></footer>
  </div>
</Layout>
