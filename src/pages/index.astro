---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects } from '../data/portfolio';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../data/blog';
const posts = (await getPosts()).slice(0, 3);
---
<Layout title={`${profile.name} — Projects & experiments`} description={profile.description}>
  <div class="site-shell">
    <Header />
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">{profile.title}</h1>
        <div class="hero-bottom">
          <p>{profile.description}</p>
          <a class="button" href="#projects">View projects <span aria-hidden="true">↓</span></a>
        </div>
      </section>
      <section id="projects" class="projects-section" aria-labelledby="projects-title">
        <div class="section-heading"><h2 id="projects-title">Projects</h2><span class="eyebrow">01 / Work & experiments</span></div>
        {projects.length > 0 ? (
          <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
        ) : (
          <div class="projects-empty"><span class="empty-mark" aria-hidden="true">[ ... ]</span><div><h3>A space for what comes next.</h3><p>Projects will appear here as I add them.</p></div><a class="text-link" href={profile.github}>Explore GitHub <span aria-hidden="true">↗</span></a></div>
        )}
      </section>
      <section id="blog" class="blog-section" aria-labelledby="blog-title">
        <div class="section-heading"><h2 id="blog-title">Blog</h2><span class="eyebrow">02 / Notes & writing</span></div>
        {posts.length ? <PostList posts={posts} /> : <p class="section-intro">No posts yet.</p>}
        <a class="text-link" href="/blog/">All posts <span aria-hidden="true">→</span></a>
      </section>
      <section id="about" class="about-section" aria-labelledby="about-title">
        <div><p class="eyebrow">03 / About</p><h2 id="about-title">Behind the handle.</h2></div>
        <div><p>{profile.about}</p><a class="text-link" href={profile.github}>Find me on GitHub <span aria-hidden="true">↗</span></a></div>
      </section>
    </main>
    <footer><span>© {new Date().getFullYear()} {profile.name}</span><a href="#main">Back to top ↑</a></footer>
  </div>
</Layout>
